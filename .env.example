# Firebase-Web-Konfiguration (aus der Firebase-Konsole: Projekt-Einstellungen
# -> Allgemein -> Meine Apps -> Web-App -> SDK-Konfiguration). Diese Werte
# sind NICHT geheim - sie sind fuer Web-Apps oeffentlich vorgesehen.
#
# Zum lokalen Testen: diese Datei nach ".env.local" kopieren und ausfuellen.
# Fuer den Deploy ueber GitHub Actions: dieselben Werte als Repository-
# Variablen unter Settings -> Secrets and variables -> Actions -> Variables
# hinterlegen (siehe .github/workflows/deploy.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL der deployten Cloud Function "anthropicProxy" (haelt den Anthropic-Key
# serverseitig geheim). Leer lassen, um die KI direkt aus dem Browser mit
# einem selbst hinterlegten Anthropic-Key aufzurufen.
# Format: https://<region>-<project-id>.cloudfunctions.net/anthropicProxy
VITE_AI_PROXY_URL=
