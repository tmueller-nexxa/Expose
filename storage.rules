rules_version = '2';

// Jeder Nutzer kann ausschliesslich in seinen EIGENEN Ordner hochladen/lesen.
// Pfad: /users/{uid}/{beliebige Datei-ID}
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
        && request.auth.uid == uid
        // Bilder oder PDF (Original-Beispiel-Exposes), max. 30 MB pro Datei.
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf')
        && request.resource.size < 30 * 1024 * 1024;
    }
  }
}
